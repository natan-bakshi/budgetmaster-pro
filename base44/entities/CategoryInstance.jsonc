{
  "name": "CategoryInstance",
  "type": "object",
  "properties": {
    "categoryId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d4\u05d1\u05e1\u05d9\u05e1\u05d9\u05ea"
    },
    "currentAmount": {
      "type": "number",
      "description": "\u05d4\u05e1\u05db\u05d5\u05dd \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 \u05dc\u05d7\u05d5\u05d3\u05e9 \u05d6\u05d4"
    },
    "month": {
      "type": "string",
      "description": "\u05d4\u05d7\u05d5\u05d3\u05e9 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 YYYY-MM"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05dc\u05d7\u05d5\u05d3\u05e9 \u05d6\u05d4"
    },
    "householdId": {
      "type": "string"
    }
  },
  "required": [
    "categoryId",
    "currentAmount",
    "month",
    "householdId"
  ],
  "rls": {
    "read": {
      "data.householdId": "{{user.data.householdId}}"
    },
    "create": {
      "data.householdId": "{{user.data.householdId}}"
    },
    "update": {
      "data.householdId": "{{user.data.householdId}}"
    },
    "delete": {
      "data.householdId": "{{user.data.householdId}}"
    }
  }
}