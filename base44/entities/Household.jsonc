{
  "name": "Household",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e9\u05e7 \u05d4\u05d1\u05d9\u05ea (\u05dc\u05d3\u05d5\u05d2\u05de\u05d4: \u05de\u05e9\u05e4\u05d7\u05ea \u05db\u05d4\u05df)"
    },
    "resetDay": {
      "type": "number",
      "description": "\u05d4\u05d9\u05d5\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9 \u05dc\u05d0\u05d9\u05e4\u05d5\u05e1 \u05d4\u05ea\u05e7\u05e6\u05d9\u05d1 (1-28)",
      "default": 1
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "id": "{{user.householdId}}"
    },
    "write": {
      "id": "{{user.householdId}}"
    }
  }
}