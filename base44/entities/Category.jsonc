{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ]
    },
    "defaultAmount": {
      "type": "number"
    },
    "accountId": {
      "type": "string"
    },
    "executionDate": {
      "type": "string"
    },
    "showNotes": {
      "type": "boolean"
    },
    "order": {
      "type": "number",
      "description": "\u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05d1\u05e8\u05e9\u05d9\u05de\u05d4 \u05dc\u05e6\u05d5\u05e8\u05da \u05de\u05d9\u05d5\u05df"
    },
    "householdId": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "householdId"
  ],
  "rls": {
    "read": {
      "householdId": "{{user.householdId}}"
    },
    "write": {
      "householdId": "{{user.householdId}}"
    }
  }
}