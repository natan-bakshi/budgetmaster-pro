{
  "name": "MonthlyHistory",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "\u05d4\u05d7\u05d5\u05d3\u05e9 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 YYYY-MM"
    },
    "totalIncome": {
      "type": "number",
      "description": "\u05e1\u05da \u05d4\u05d4\u05db\u05e0\u05e1\u05d5\u05ea \u05dc\u05d7\u05d5\u05d3\u05e9"
    },
    "totalExpenses": {
      "type": "number",
      "description": "\u05e1\u05da \u05d4\u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05dc\u05d7\u05d5\u05d3\u05e9"
    },
    "balance": {
      "type": "number",
      "description": "\u05d4\u05d9\u05ea\u05e8\u05d4 \u05d4\u05d7\u05d5\u05d3\u05e9\u05d9\u05ea"
    },
    "householdId": {
      "type": "string"
    }
  },
  "required": [
    "month",
    "totalIncome",
    "totalExpenses",
    "balance",
    "householdId"
  ],
  "rls": {
    "read": {
      "householdId": "{{user.householdId}}"
    },
    "write": {
      "householdId": "{{user.householdId}}"
    }
  }
}