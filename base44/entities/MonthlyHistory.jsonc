{
  "name": "MonthlyHistory",
  "type": "object",
  "properties": {
    "month": {
      "type": "string",
      "description": "\u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05ea\u05e7\u05e6\u05d9\u05d1 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 YYYY-MM"
    },
    "totalIncome": {
      "type": "number",
      "description": "\u05e1\u05da \u05d4\u05d4\u05db\u05e0\u05e1\u05d5\u05ea \u05dc\u05ea\u05e7\u05d5\u05e4\u05d4"
    },
    "totalExpenses": {
      "type": "number",
      "description": "\u05e1\u05da \u05d4\u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05dc\u05ea\u05e7\u05d5\u05e4\u05d4"
    },
    "balance": {
      "type": "number",
      "description": "\u05d4\u05d9\u05ea\u05e8\u05d4 \u05dc\u05ea\u05e7\u05d5\u05e4\u05d4"
    },
    "categoryDetails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "income",
              "expense"
            ]
          },
          "amount": {
            "type": "number"
          },
          "notes": {
            "type": "string"
          },
          "order": {
            "type": "number"
          }
        }
      },
      "description": "\u05e6\u05d9\u05dc\u05d5\u05dd \u05de\u05e6\u05d1 \u05e9\u05dc \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d5\u05ea \u05d5\u05d4\u05e1\u05db\u05d5\u05de\u05d9\u05dd \u05d1\u05ea\u05e7\u05d5\u05e4\u05d4"
    },
    "transactionDetails": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "date": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "income",
              "expense"
            ]
          },
          "isAutomatic": {
            "type": "boolean"
          },
          "isExecuted": {
            "type": "boolean"
          }
        }
      },
      "description": "\u05e6\u05d9\u05dc\u05d5\u05dd \u05de\u05e6\u05d1 \u05e9\u05dc \u05d4\u05e2\u05e1\u05e7\u05d0\u05d5\u05ea \u05d1\u05ea\u05e7\u05d5\u05e4\u05d4"
    },
    "householdId": {
      "type": "string"
    }
  },
  "required": [
    "month",
    "totalIncome",
    "totalExpenses",
    "balance",
    "householdId"
  ],
  "rls": {
    "read": {
      "data.householdId": "{{user.data.householdId}}"
    },
    "create": {
      "data.householdId": "{{user.data.householdId}}"
    },
    "update": {
      "$and": [
        {
          "data.householdId": "{{user.data.householdId}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.householdId": "{{user.data.householdId}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}