{
  "name": "User",
  "type": "object",
  "properties": {
    "defaultAccountId": {
      "type": "string"
    },
    "householdId": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ],
      "default": "member",
      "description": "\u05d4\u05e8\u05e9\u05d0\u05ea \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05de\u05e9\u05e7 \u05d4\u05d1\u05d9\u05ea"
    },
    "isTemporary": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d6\u05d4 \u05d7\u05e9\u05d1\u05d5\u05df \u05d6\u05de\u05e0\u05d9 \u05d0\u05d9\u05e9\u05d9"
    },
    "lastUpdateTime": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e2\u05d3\u05db\u05df \u05de\u05e9\u05d4\u05d5 \u05d1\u05e4\u05d5\u05e2\u05dc \u05dc\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "lastResetCheck": {
      "type": "string",
      "format": "date-time",
      "description": "\u05de\u05ea\u05d9 \u05d1\u05d5\u05e6\u05e2\u05d4 \u05d1\u05d3\u05d9\u05e7\u05ea \u05d0\u05d9\u05e4\u05d5\u05e1 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    }
  },
  "required": [
    "defaultAccountId",
    "householdId",
    "lastUpdateTime",
    "lastResetCheck"
  ]
}