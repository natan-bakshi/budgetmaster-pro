    }
  ],
  "whatsapp_greeting": "\u05e9\u05dc\u05d5\u05dd! \ud83d\udc4b\n\u05d0\u05e0\u05d9 \u05de\u05d0\u05e1\u05d8\u05e8.\n\u05e9\u05d0\u05dc \u05d0\u05d5\u05ea\u05d9: \"\u05db\u05de\u05d4 \u05e0\u05e9\u05d0\u05e8 \u05e2\u05d3 \u05e1\u05d5\u05e3 \u05d4\u05d7\u05d5\u05d3\u05e9?\""
}